        {
          "id": "b3d94519-87d4-4b60-b262-b84ddfd28a84",
          "name": "Retrieves details on a specific settlement",
          "request": {
            "name": "Retrieves details on a specific settlement",
            "description": {
              "content": "This endpoint allows you to get all details for a specific settlement based on its settlement ID. Details include:\n\n- Bank transfer info (bank name, recipient IBAN, etc.)\n\n- Total amount transferred to the bank account\n\n- Detailed amounts (sales, refunds, chargebacks, fees, etc.)\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "settlement",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "",
                  "key": "id",
                  "description": "(Required) The settlement ID."
                }
